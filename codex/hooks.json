{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/github/chrome-review/codex/hooks/run-hook.sh sessionStart",
            "timeout": 70
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/github/chrome-review/codex/hooks/run-hook.sh userPromptSubmit",
            "timeout": 40
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/github/chrome-review/codex/hooks/run-hook.sh preToolUse",
            "timeout": 70
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/github/chrome-review/codex/hooks/run-hook.sh postToolUse",
            "timeout": 70
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/github/chrome-review/codex/hooks/run-hook.sh stop",
            "timeout": 70
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/github/chrome-review/codex/hooks/run-hook.sh subagentStop",
            "timeout": 70
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/github/chrome-review/codex/hooks/run-hook.sh permissionRequest",
            "timeout": 86410
          }
        ]
      }
    ]
  }
}
