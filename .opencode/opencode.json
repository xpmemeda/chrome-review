{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "remote_fleet": {
        "type": "remote",
        "url": "http://127.0.0.1:18766/mcp",
        "oauth": false
      }
    }
  },
  "providers": {
    "sub2api": {
      "name": "Sub2API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://212.50.233.61:18000/v1",
        "apiKey": "{file:~/.secrets/sub2api.key}"
      },
      "models": {
        "gpt-6-astra": {
          "modelID": "gpt-6-astra",
          "name": "GPT-6 Astra (relay)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh"]
            }
          },
          "limit": {
            "context": 600000,
            "output": 32000
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    },
    "anthropic": {
      "name": "Anthropic",
      "package": "@opencode/ai/providers/anthropic-compatible",
      "settings": {
        "baseURL": "http://74.211.111.53:8080/v1",
        "apiKey": "{file:~/workspace/github/notes-with-sphinx/.secrets/anthropic.key}"
      },
      "models": {
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        }
      }
    },
    "antigravity": {
      "name": "Antigravity",
      "package": "@opencode/ai/providers/anthropic-compatible",
      "settings": {
        "baseURL": "http://74.211.111.53:8080/v1",
        "apiKey": "{file:~/workspace/github/notes-with-sphinx/.secrets/antigravity.key}"
      },
      "models": {
        "gemini-4-argon": {
          "name": "Gemini 4 Argon",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "gemini-pro-agent": {
          "name": "Gemini Pro Agent",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        }
      }
    }
  }
}
