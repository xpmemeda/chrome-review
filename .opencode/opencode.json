{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "remote_fleet": {
        "type": "remote",
        "url": "http://127.0.0.1:18766/mcp",
        "oauth": false
      }
    }
  },
  "providers": {
    "sub2api": {
      "name": "Sub2API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://212.50.233.61:18000/v1",
        "apiKey": "{file:~/.secrets/sub2api.key}"
      },
      "models": {
        "gpt-6-astra": {
          "modelID": "gpt-6-astra",
          "name": "GPT-6 Astra (relay)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh"]
            }
          },
          "limit": {
            "context": 600000,
            "output": 32000
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}
